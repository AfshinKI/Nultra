<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_app" android:textColor="#F4F8FB" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button style="?android:attr/buttonBarButtonStyle" android:background="@drawable/widget_button" android:layout_marginEnd="2dp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:id="@+id/widget_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/widget_off" android:textSize="12sp" android:textColor="#A4F1D4" android:contentDescription="@string/widget_off_description" />
        <Button style="?android:attr/buttonBarButtonStyle" android:background="@drawable/widget_button" android:layout_marginStart="2dp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:id="@+id/widget_on" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/widget_on" android:textSize="12sp" android:textColor="#FFDC40" android:contentDescription="@string/widget_on_description" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#93A8B5" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
